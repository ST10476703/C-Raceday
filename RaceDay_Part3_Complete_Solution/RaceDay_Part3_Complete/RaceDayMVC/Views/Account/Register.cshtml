@model RegisterForm
@{ ViewData["Title"] = "Join RaceDay"; }
<section class="auth-shell"><div class="auth-intro"><span class="overline">JOIN THE MOVEMENT</span><h1>EVERY RACE <em>STARTS</em> HERE.</h1><p>Join as a participant or organise the next big event.</p></div><div class="form-card"><h2>Create your account</h2><p class="muted">One account. Infinite starting lines.</p><form asp-action="Register" method="post"><div asp-validation-summary="All" class="validation"></div><div class="form-grid"><div class="form-field"><label asp-for="FirstName"></label><input asp-for="FirstName" /></div><div class="form-field"><label asp-for="LastName"></label><input asp-for="LastName" /></div></div><div class="form-field"><label asp-for="Email"></label><input asp-for="Email" /></div><div class="form-field"><label asp-for="Password"></label><input asp-for="Password" /></div><div class="form-field"><label asp-for="Role">I want to</label><select asp-for="Role"><option value="Participant">Enter events (Participant)</option><option value="Organiser">Organise events (Organiser)</option></select></div><button class="btn btn-accent btn-wide" type="submit">Create account →</button><p class="auth-foot">Already a member? <a asp-action="Login">Log in</a></p></form></div></section>
