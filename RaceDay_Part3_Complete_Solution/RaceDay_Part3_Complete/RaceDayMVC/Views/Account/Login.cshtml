@model LoginForm
@{ ViewData["Title"] = "Log in"; }
<section class="auth-shell"><div class="auth-intro"><span class="overline">WELCOME BACK</span><h1>THE NEXT <em>MOVE</em> IS YOURS.</h1><p>Your races, your results, your next personal best.</p></div><div class="form-card"><h2>Log in</h2><p class="muted">Enter your RaceDay credentials to continue.</p><form asp-action="Login" method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><input asp-for="ReturnUrl" type="hidden" /><div class="form-field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" placeholder="you@example.com" /><span asp-validation-for="Email" class="validation"></span></div><div class="form-field"><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" placeholder="Your password" /><span asp-validation-for="Password" class="validation"></span></div><button class="btn btn-accent btn-wide" type="submit">Log in →</button><p class="auth-foot">New here? <a asp-action="Register">Create your account</a></p></form></div></section>
