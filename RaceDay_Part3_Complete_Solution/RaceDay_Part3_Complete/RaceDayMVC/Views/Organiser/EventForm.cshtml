@model EventForm
@{ bool editing = (string?)ViewContext.RouteData.Values["action"] == "Edit"; ViewData["Title"] = editing ? "Edit event" : "Create event"; }
<a asp-action="Events" class="back-link">← Manage events</a>
<div class="page-top"><div><p class="eyebrow">EVENT MANAGEMENT</p><h1 class="page-title">@(editing ? "EDIT" : "CREATE") <em>EVENT.</em></h1></div></div>
<div class="form-card form-card-wide"><form method="post" enctype="multipart/form-data"><div asp-validation-summary="All" class="validation"></div><input asp-for="BannerImageLink" type="hidden" /><div class="form-field"><label asp-for="Name">Event name</label><input asp-for="Name" placeholder="Pretoria City 10K" /><span asp-validation-for="Name" class="validation"></span></div><div class="form-field"><label asp-for="Description"></label><textarea asp-for="Description" rows="4" placeholder="Tell runners about the event..."></textarea></div><div class="form-grid"><div class="form-field"><label asp-for="EventDate">Event date</label><input asp-for="EventDate" type="date" asp-format="{0:yyyy-MM-dd}" /></div><div class="form-field"><label asp-for="Location"></label><input asp-for="Location" placeholder="Pretoria" /></div></div><div class="form-grid"><div class="form-field"><label asp-for="Distance">Distance (km)</label><input asp-for="Distance" type="number" step="0.01" min="0.01" /></div><div class="form-field"><label asp-for="EventType">Discipline</label><select asp-for="EventType"><option value="Running">Running</option><option value="Cycling">Cycling</option><option value="Walking">Walking</option></select></div></div><div class="form-field"><label asp-for="BannerFile">Event banner (JPG, PNG or WebP; max 5 MB)</label><input asp-for="BannerFile" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" /><small>Stored in Azure Blob Storage through the API. Requires Azure configuration.</small></div><div class="form-actions"><button type="submit" class="btn btn-accent">@(editing ? "Save changes" : "Create event") →</button><a class="btn btn-outline" asp-action="Events">Cancel</a></div></form></div>
