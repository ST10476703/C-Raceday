@model CategoryForm
@{ ViewData["Title"] = "Edit category"; }
<a class="back-link" asp-action="Categories" asp-route-eventId="@ViewBag.EventId">← Categories</a>
<div class="page-top"><div><p class="eyebrow">EVENT / CATEGORIES</p><h1 class="page-title">EDIT <em>CATEGORY.</em></h1></div></div>
<div class="form-card form-card-wide"><form method="post" asp-action="EditCategory" asp-route-id="@ViewBag.CategoryId" asp-route-eventId="@ViewBag.EventId"><div asp-validation-summary="All" class="validation"></div><div class="form-field"><label asp-for="Name"></label><input asp-for="Name" /></div><div class="form-field"><label asp-for="CategoryType"></label><select asp-for="CategoryType"><option>Running</option><option>Cycling</option><option>Walking</option></select></div><div class="form-grid"><div class="form-field"><label asp-for="MinimumAge"></label><input asp-for="MinimumAge" type="number" /></div><div class="form-field"><label asp-for="MaximumAge"></label><input asp-for="MaximumAge" type="number" /></div></div><div class="form-field"><label asp-for="Distance">Distance (km)</label><input asp-for="Distance" type="number" step="0.01" /></div><button class="btn btn-accent" type="submit">Save category →</button></form></div>
