@model OrganiserEnrolmentPage
@{ ViewData["Title"] = "Entries and results"; }
<a class="back-link" asp-action="Events">← Manage events</a>
<div class="page-top"><div><p class="eyebrow">@Model.Event.Name.ToUpperInvariant()</p><h1 class="page-title">ENTRIES & <em>RESULTS.</em></h1><p class="muted">@Model.Enrolments.Count entries · @Model.Results.Count recorded results</p></div><a class="btn btn-outline" asp-action="Categories" asp-route-eventId="@Model.Event.EventId">Manage categories</a></div>
<section class="panel"><div class="section-head"><h2>Registered participants</h2><span class="count-label">@Model.Enrolments.Count participants</span></div>
@if (!Model.Enrolments.Any()) { <div class="empty-state"><p>No participants have entered this event yet.</p></div> }
else { <div class="table-wrap"><table class="data-table"><thead><tr><th>PARTICIPANT</th><th>CATEGORY</th><th>ENTRY STATUS</th><th>RESULT</th></tr></thead><tbody>@foreach (var e in Model.Enrolments) { var result = Model.Results.FirstOrDefault(r => r.EnrolmentId == e.EnrolmentId);<tr><td><strong>@e.ParticipantName</strong><span class="table-sub">@e.ParticipantEmail</span></td><td>@e.CategoryName</td><td><span class="status-badge @(e.Status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase) ? "confirmed" : "pending")">@e.Status</span></td><td>@if (result is null) { <a class="text-link" asp-action="RecordResult" asp-route-enrolmentId="@e.EnrolmentId" asp-route-eventId="@Model.Event.EventId">Record result →</a> } else { <span>@(result.FinishTime?.ToString("HH:mm:ss") ?? "–") · #@result.FinishPosition</span> <a class="text-link" asp-action="EditResult" asp-route-id="@result.ResultId" asp-route-eventId="@Model.Event.EventId">Edit</a> }</td></tr> }</tbody></table></div> }
</section>
<section class="panel section-block"><div class="section-head"><h2>Published leaderboard</h2><span class="count-label">@Model.Results.Count results</span></div>@if (!Model.Results.Any()) { <p class="muted">No results recorded yet.</p> }else { <div class="table-wrap"><table class="data-table"><thead><tr><th>POSITION</th><th>ATHLETE</th><th>CATEGORY</th><th>FINISH TIME</th></tr></thead><tbody>@foreach (var r in Model.Results.OrderBy(x => x.FinishPosition)) { <tr><td><span class="place-mark">#@r.FinishPosition</span></td><td>@r.ParticipantName</td><td>@r.CategoryName</td><td class="mono">@(r.FinishTime?.ToString("HH:mm:ss") ?? "–")</td></tr> }</tbody></table></div> }</section>
