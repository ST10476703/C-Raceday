@model List<EventDto>
@{ ViewData["Title"] = "Manage events"; }
<div class="page-top"><div><p class="eyebrow">ORGANISER / EVENTS</p><h1 class="page-title">MANAGE <em>EVENTS.</em></h1><p class="muted">Edit listings, manage divisions and publish results.</p></div><a class="btn btn-accent" asp-action="Create">+ New event</a></div>
@if (!Model.Any()) { <div class="empty-state"><h3>Your event board is empty.</h3><a class="btn btn-accent" asp-action="Create">Create your first event</a></div> }
else { <div class="event-manage-grid">@foreach (var ev in Model.OrderBy(x => x.EventDate)) { <article class="manage-card"><div class="manage-date"><strong>@ev.EventDate.Day</strong><span>@ev.EventDate.ToString("MMM").ToUpperInvariant()</span></div><div class="manage-body"><p class="eyebrow">@ev.EventType · @ev.Distance km</p><h3>@ev.Name</h3><p class="muted">@ev.Location</p><div class="manage-actions"><a asp-action="Edit" asp-route-id="@ev.EventId">Edit</a><a asp-action="Categories" asp-route-eventId="@ev.EventId">Categories</a><a asp-action="Enrolments" asp-route-eventId="@ev.EventId">Entries & results</a><a asp-controller="Home" asp-action="Details" asp-route-id="@ev.EventId">Preview</a><form asp-action="Delete" asp-route-id="@ev.EventId" method="post" onsubmit="return confirm('Delete this event? This may fail if enrolments exist.');"><button class="text-danger" type="submit">Delete</button></form></div></div></article> }</div> }
