@model CategoryPage
@{ ViewData["Title"] = "Event categories"; }
<a class="back-link" asp-action="Events">← Manage events</a>
<div class="page-top"><div><p class="eyebrow">@Model.Event.Name.ToUpperInvariant()</p><h1 class="page-title">RACE <em>CATEGORIES.</em></h1></div><a class="btn btn-outline" asp-action="Enrolments" asp-route-eventId="@Model.Event.EventId">See enrolments →</a></div>
<div class="split-layout"><section class="panel"><h2>Current categories</h2>@if (!Model.Categories.Any()) { <p class="muted">No categories yet. Create one to enable participant entries.</p> }else { <div class="table-wrap"><table class="data-table"><thead><tr><th>CATEGORY</th><th>AGE</th><th>DISTANCE</th><th></th></tr></thead><tbody>@foreach (var c in Model.Categories) { <tr><td><strong>@c.Name</strong><span class="table-sub">@c.CategoryType</span></td><td>@(c.MinimumAge?.ToString() ?? "Any") – @(c.MaximumAge?.ToString() ?? "Any")</td><td>@(c.Distance?.ToString("0.##") ?? "–") km</td><td><div class="row-actions"><a asp-action="EditCategory" asp-route-id="@c.CategoryId" asp-route-eventId="@Model.Event.EventId">Edit</a><form method="post" asp-action="DeleteCategory" asp-route-id="@c.CategoryId" asp-route-eventId="@Model.Event.EventId" onsubmit="return confirm('Delete category?');"><button class="text-danger" type="submit">Delete</button></form></div></td></tr> }</tbody></table></div> }</section>
<aside class="panel"><h2>Add a category</h2><form method="post" asp-action="AddCategory" asp-route-eventId="@Model.Event.EventId"><div class="form-field"><label for="catName">Category name</label><input id="catName" name="Name" placeholder="10km Open" required /></div><div class="form-field"><label for="catType">Discipline</label><select id="catType" name="CategoryType"><option>Running</option><option>Cycling</option><option>Walking</option></select></div><div class="form-grid"><div class="form-field"><label for="minAge">Minimum age</label><input id="minAge" name="MinimumAge" type="number" min="0" max="120" /></div><div class="form-field"><label for="maxAge">Maximum age</label><input id="maxAge" name="MaximumAge" type="number" min="0" max="120" /></div></div><div class="form-field"><label for="catDistance">Distance (km)</label><input id="catDistance" name="Distance" type="number" step="0.01" min="0.01" value="5" required /></div><button class="btn btn-accent btn-wide" type="submit">Add category →</button></form></aside></div>
