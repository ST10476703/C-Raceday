@model ResultForm
@{ bool editing = ViewBag.ResultId != null; ViewData["Title"] = editing ? "Edit result" : "Record result"; }
<a class="back-link" asp-action="Enrolments" asp-route-eventId="@ViewBag.EventId">← Enrolments</a>
<div class="page-top"><div><p class="eyebrow">OFFICIAL RACE RESULTS</p><h1 class="page-title">@(editing ? "EDIT" : "RECORD") <em>RESULT.</em></h1></div></div>
<div class="form-card form-card-wide"><form method="post" asp-action="@(editing ? "EditResult" : "RecordResult")" asp-route-id="@ViewBag.ResultId" asp-route-enrolmentId="@ViewBag.EnrolmentId" asp-route-eventId="@ViewBag.EventId"><div asp-validation-summary="All" class="validation"></div><div class="form-grid"><div class="form-field"><label asp-for="FinishTime">Finish time (HH:mm:ss)</label><input asp-for="FinishTime" placeholder="01:20:30" /><span asp-validation-for="FinishTime" class="validation"></span></div><div class="form-field"><label asp-for="FinishPosition">Finishing position</label><input asp-for="FinishPosition" type="number" min="1" /><span asp-validation-for="FinishPosition" class="validation"></span></div></div><p class="small muted">RaceDay currently supports finish durations under 24 hours, following the existing database schema.</p><button class="btn btn-accent" type="submit">Publish result →</button></form></div>
