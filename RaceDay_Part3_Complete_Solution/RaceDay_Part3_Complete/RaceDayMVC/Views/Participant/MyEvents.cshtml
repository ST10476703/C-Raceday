@model List<EnrolmentDto>
@{ ViewData["Title"] = "My events"; }
<div class="page-top"><div><p class="eyebrow">PARTICIPANT / MY ENTRIES</p><h1 class="page-title">MY <em>EVENTS.</em></h1><p class="muted">Every starting line you've committed to.</p></div><a class="btn btn-accent" asp-controller="Home" asp-action="Index">Explore more races</a></div>
@if (!Model.Any()) { <div class="empty-state"><span class="empty-icon">↗</span><h3>Your race calendar is waiting.</h3><p>Choose an event and register for your first challenge.</p><a class="btn btn-accent" asp-controller="Home" asp-action="Index">Discover events</a></div> }
else { <div class="entry-grid">@foreach (var e in Model.OrderBy(x => x.EventDate)) { <article class="entry-card"><div class="entry-date"><strong>@e.EventDate.Day</strong><small>@e.EventDate.ToString("MMM").ToUpperInvariant()</small></div><div class="entry-body"><p class="eyebrow">ENTRY #@e.EnrolmentId</p><h3><a asp-controller="Home" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a></h3><p class="muted">Category: @e.CategoryName</p><span class="status-badge @(e.Status.Equals("Confirmed",StringComparison.OrdinalIgnoreCase) ? "confirmed" : "pending")">@e.Status</span></div><a class="text-link" asp-controller="Home" asp-action="Details" asp-route-id="@e.EventId">Details →</a></article> }</div> }
