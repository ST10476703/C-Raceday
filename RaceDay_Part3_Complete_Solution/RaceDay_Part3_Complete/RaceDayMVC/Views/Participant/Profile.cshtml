@model ProfileForm
@{ ViewData["Title"] = "My profile"; }
<div class="page-top"><div><p class="eyebrow">PARTICIPANT / PROFILE</p><h1 class="page-title">MY <em>PROFILE.</em></h1><p class="muted">Make sure your details are race-ready.</p></div></div>
<div class="split-layout"><div class="panel"><div class="profile-top">@if (!string.IsNullOrEmpty(Model.ProfileImageLink)) { <img class="avatar-xl" src="@Url.Action("Show", "Images", new { imageUrl = Model.ProfileImageLink })" alt="Current profile picture" /> } else { <div class="avatar-xl avatar-placeholder">@Model.FirstName.FirstOrDefault()</div> }<div><h2>@Model.FirstName @Model.LastName</h2><p class="muted">@Model.Email</p><span class="role-pill">Participant</span></div></div><p class="small muted">Your profile image is stored through RaceDay's API in Azure Blob Storage, when configured.</p></div>
<div class="form-card"><h2>Update details</h2><form asp-action="Profile" method="post" enctype="multipart/form-data"><div asp-validation-summary="All" class="validation"></div><input asp-for="Email" type="hidden" /><input asp-for="ProfileImageLink" type="hidden" /><div class="form-grid"><div class="form-field"><label asp-for="FirstName"></label><input asp-for="FirstName" /></div><div class="form-field"><label asp-for="LastName"></label><input asp-for="LastName" /></div></div><div class="form-field"><label asp-for="Phone"></label><input asp-for="Phone" placeholder="08x xxx xxxx" /></div><div class="form-field"><label asp-for="ProfileImage">Profile picture</label><input asp-for="ProfileImage" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" /><small>JPG, PNG or WebP, max 5 MB.</small></div><button class="btn btn-accent btn-wide" type="submit">Save my profile →</button></form></div></div>
