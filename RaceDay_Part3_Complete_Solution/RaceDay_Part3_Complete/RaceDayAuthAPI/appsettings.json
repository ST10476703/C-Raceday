{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "RaceDayApi",
    "Audience": "RaceDayClient"
  },
  "ConnectionStrings": {
